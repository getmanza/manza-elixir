#!/usr/bin/env bash
# bin/release adapter: print the current version, or write a new one into every
# tracked file that carries it (the @version attribute in mix.exs).
set -euo pipefail
cd "$(dirname "$0")/.."

if [ $# -eq 0 ]; then
  sed -nE 's/^  @version "([^"]+)"$/\1/p' mix.exs
  exit 0
fi

sed -i.bak -E "s/^  @version \"[^\"]+\"$/  @version \"$1\"/" mix.exs
rm -f mix.exs.bak
